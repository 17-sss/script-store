#!/usr/bin/env bash

# Run Codex in a project-specific tmux session.

print_cx_help() {
  cat <<'EOF'
Usage: cx [CX_OPTIONS] [CODEX_OPTIONS] [PROMPT|COMMAND ...]

cx shortcuts:
  Models:
    --sol       --model gpt-5.6-sol
    --terra     --model gpt-5.6-terra
    --luna      --model gpt-5.6-luna
    --gpt55     --model gpt-5.5
    --gpt54     --model gpt-5.4
    --mini      --model gpt-5.4-mini
    --spark     --model gpt-5.3-codex-spark

  Reasoning (model support varies):
    --low --medium --high --xhigh --max --ultra

  Permission presets:
    --safe       read-only + untrusted approvals
    --auto       workspace-write + on-request approvals
    --full-auto  workspace-write + no approval prompts
    --madmax     --yolo (no sandbox or approval prompts)

  Other:
    --cx-help    Show this help
    --           Stop interpreting cx shortcuts

All other options are passed to Codex unchanged.
EOF
}

shortcut_conflict() {
  printf 'cx: %s shortcuts cannot be combined: %s and %s\n' "$1" "$2" "$3" >&2
  exit 2
}

add_model_shortcut() {
  local shortcut="$1"
  local model="$2"

  if [ -n "$model_shortcut" ]; then
    shortcut_conflict model "$model_shortcut" "$shortcut"
  fi
  model_shortcut="$shortcut"
  codex_args+=(--model "$model")
}

add_reasoning_shortcut() {
  local shortcut="$1"
  local effort="$2"

  if [ -n "$reasoning_shortcut" ]; then
    shortcut_conflict reasoning "$reasoning_shortcut" "$shortcut"
  fi
  reasoning_shortcut="$shortcut"
  codex_args+=(
    -c
    "model_reasoning_effort=\"$effort\""
  )
}

add_permission_shortcut() {
  local shortcut="$1"

  if [ -n "$permission_shortcut" ]; then
    shortcut_conflict permission "$permission_shortcut" "$shortcut"
  fi
  permission_shortcut="$shortcut"

  case "$shortcut" in
    --safe)
      codex_args+=(--sandbox read-only --ask-for-approval untrusted)
      ;;
    --auto)
      codex_args+=(--sandbox workspace-write --ask-for-approval on-request)
      ;;
    --full-auto)
      codex_args+=(--sandbox workspace-write --ask-for-approval never)
      ;;
    --madmax)
      codex_args+=(--yolo)
      ;;
  esac
}

session_directory="${PWD##*/}"
if [ -z "$session_directory" ]; then
  session_directory="/"
fi

session="codex-${session_directory}-$(date +%H%M%S)"
session="${session//[^A-Za-z0-9_-]/-}"

codex_args=(--no-alt-screen)
passthrough=0
model_shortcut=
reasoning_shortcut=
permission_shortcut=

for arg in "$@"; do
  if [ "$passthrough" -eq 1 ]; then
    codex_args+=("$arg")
    continue
  fi

  case "$arg" in
    --cx-help)
      print_cx_help
      exit 0
      ;;
    --)
      passthrough=1
      codex_args+=("$arg")
      ;;
    --sol)
      add_model_shortcut "$arg" gpt-5.6-sol
      ;;
    --terra)
      add_model_shortcut "$arg" gpt-5.6-terra
      ;;
    --luna)
      add_model_shortcut "$arg" gpt-5.6-luna
      ;;
    --gpt55)
      add_model_shortcut "$arg" gpt-5.5
      ;;
    --gpt54)
      add_model_shortcut "$arg" gpt-5.4
      ;;
    --mini)
      add_model_shortcut "$arg" gpt-5.4-mini
      ;;
    --spark)
      add_model_shortcut "$arg" gpt-5.3-codex-spark
      ;;
    --low|--medium|--high|--xhigh|--max|--ultra)
      add_reasoning_shortcut "$arg" "${arg#--}"
      ;;
    --safe|--auto|--full-auto|--madmax)
      add_permission_shortcut "$arg"
      ;;
    *)
      codex_args+=("$arg")
      ;;
  esac
done

if ! command -v codex >/dev/null 2>&1; then
  printf 'cx: codex command not found\n' >&2
  exit 127
fi

if ! command -v tmux >/dev/null 2>&1; then
  printf 'cx: tmux not found; launching Codex directly\n' >&2
  exec codex "${codex_args[@]}"
fi

if ! tmux new-session \
  -d \
  -s "$session" \
  -c "$PWD" \
  codex "${codex_args[@]}"
then
  exit 1
fi

if ! tmux set-option -t "$session" mouse on; then
  tmux kill-session -t "$session" >/dev/null 2>&1 || true
  exit 1
fi

# Do not preserve a dead pane even when the user's global tmux setting does.
if ! tmux set-option -w -t "$session" remain-on-exit off; then
  tmux kill-session -t "$session" >/dev/null 2>&1 || true
  exit 1
fi

if [ -n "${TMUX:-}" ]; then
  exec tmux switch-client -t "$session"
fi

exec tmux attach-session -t "$session"

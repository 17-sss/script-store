#!/usr/bin/env bash

# Run Codex in a project-specific tmux session and manage cxt sessions.

CXT_SESSION_PREFIX='codex-'
CXT_TMUX_HISTORY_LIMIT='50000'
CXT_TRANSCRIPT_CONFIG='tui.keymap.global.open_transcript="ctrl-t"'

print_cxt_help() {
  cat <<'EOF'
Usage: cxt [CXT_OPTIONS] [CODEX_OPTIONS] [PROMPT|COMMAND ...]

cxt shortcuts:
  Models:
    --sol       --model gpt-5.6-sol
    --terra     --model gpt-5.6-terra
    --luna      --model gpt-5.6-luna
    --gpt55     --model gpt-5.5
    --gpt54     --model gpt-5.4
    --mini      --model gpt-5.4-mini
    --spark     --model gpt-5.3-codex-spark

  Reasoning (model support varies):
    --low --medium --high --xhigh --max --ultra

  Permission presets:
    --safe       read-only + untrusted approvals
    --auto       workspace-write + on-request approvals
    --full-auto  workspace-write + no approval prompts
    --madmax     --yolo (no sandbox or approval prompts)

  Session management:
    --attach, --at [SESSION]       Attach/switch to the newest cxt session
    --kill-session, --ks [SESSION] Kill the current or newest cxt session
    --kill-all, --ka               Kill all cxt sessions

  Other:
    Ctrl+T        Open the current Codex transcript
    --cxt-help    Show this help
    --            Stop interpreting cxt shortcuts

All other options are passed to Codex unchanged.
Without tmux, Codex still launches directly with transcript access enabled.
With tmux, new cxt windows keep up to 50000 lines of scrollback.
EOF
}

add_session_action() {
  local action="$1"
  local shortcut="$2"

  if [ -n "$session_action" ]; then
    shortcut_conflict 'session management' "$session_shortcut" "$shortcut"
  fi
  session_action="$action"
  session_shortcut="$shortcut"
}

set_session_target() {
  local target="$1"

  if [ -z "$target" ]; then
    printf 'cxt: %s requires a non-empty session name after =\n' "$session_shortcut" >&2
    exit 2
  fi
  session_target="$target"
}

validate_cxt_session_name() {
  local target="$1"
  local suffix

  case "$target" in
    "$CXT_SESSION_PREFIX"*) ;;
    *)
      printf 'cxt: not a cxt tmux session: %s\n' "$target" >&2
      return 2
      ;;
  esac

  suffix="${target#"$CXT_SESSION_PREFIX"}"
  case "$suffix" in
    ''|*[!A-Za-z0-9_-]*)
      printf 'cxt: not a valid cxt tmux session name: %s\n' "$target" >&2
      return 2
      ;;
  esac
}

cxt_session_rows() {
  local rows

  rows="$(tmux list-sessions -F '#{session_created}:#{session_name}' 2>/dev/null)" || rows=
  printf '%s\n' "$rows"
}

cxt_session_exists() {
  local target="$1"
  local created candidate

  while IFS=: read -r created candidate; do
    [ "$candidate" = "$target" ] && return 0
  done <<EOF
$(cxt_session_rows)
EOF
  return 1
}

latest_cxt_session() {
  local created candidate
  local latest_created=-1
  local latest_session=

  while IFS=: read -r created candidate; do
    case "$candidate" in
      "$CXT_SESSION_PREFIX"*) ;;
      *) continue ;;
    esac
    case "$created" in
      ''|*[!0-9]*) continue ;;
    esac
    if [ "$created" -ge "$latest_created" ]; then
      latest_created="$created"
      latest_session="$candidate"
    fi
  done <<EOF
$(cxt_session_rows)
EOF

  [ -n "$latest_session" ] || return 1
  printf '%s\n' "$latest_session"
}

current_cxt_session() {
  local current_session

  [ -n "${TMUX:-}" ] || return 1
  current_session="$(tmux display-message -p '#{session_name}' 2>/dev/null)" || return 1
  validate_cxt_session_name "$current_session" >/dev/null 2>&1 || return 1
  cxt_session_exists "$current_session" || return 1
  printf '%s\n' "$current_session"
}

resolve_cxt_session() {
  local prefer_current="$1"
  local resolved_session

  if [ -n "$session_target" ]; then
    validate_cxt_session_name "$session_target" || return $?
    if ! cxt_session_exists "$session_target"; then
      printf 'cxt: cxt tmux session not found: %s\n' "$session_target" >&2
      return 1
    fi
    printf '%s\n' "$session_target"
    return 0
  fi

  if [ "$prefer_current" -eq 1 ]; then
    resolved_session="$(current_cxt_session)" && {
      printf '%s\n' "$resolved_session"
      return 0
    }
  fi

  resolved_session="$(latest_cxt_session)" || {
    printf 'cxt: no cxt tmux sessions found\n' >&2
    return 1
  }
  printf '%s\n' "$resolved_session"
}

run_session_action() {
  local target current_session
  local sessions=()
  local created candidate
  local failed=0

  if ! command -v tmux >/dev/null 2>&1; then
    printf 'cxt: tmux command not found\n' >&2
    exit 127
  fi

  case "$session_action" in
    attach)
      target="$(resolve_cxt_session 0)" || exit $?
      if [ -n "${TMUX:-}" ]; then
        exec tmux switch-client -t "$target"
      fi
      exec tmux attach-session -t "$target"
      ;;
    kill-one)
      target="$(resolve_cxt_session 1)" || exit $?
      exec tmux kill-session -t "$target"
      ;;
    kill-all)
      while IFS=: read -r created candidate; do
        case "$candidate" in
          "$CXT_SESSION_PREFIX"*) sessions+=("$candidate") ;;
        esac
      done <<EOF
$(cxt_session_rows)
EOF

      if [ "${#sessions[@]}" -eq 0 ]; then
        printf 'cxt: no cxt tmux sessions found\n' >&2
        exit 1
      fi

      current_session=
      if [ -n "${TMUX:-}" ]; then
        current_session="$(tmux display-message -p '#{session_name}' 2>/dev/null)" || current_session=
      fi

      for candidate in "${sessions[@]}"; do
        [ "$candidate" = "$current_session" ] && continue
        tmux kill-session -t "$candidate" || failed=1
      done
      if [ -n "$current_session" ]; then
        for candidate in "${sessions[@]}"; do
          if [ "$candidate" = "$current_session" ]; then
            exec tmux kill-session -t "$current_session"
          fi
        done
      fi
      exit "$failed"
      ;;
  esac
}

shortcut_conflict() {
  printf 'cxt: %s shortcuts cannot be combined: %s and %s\n' "$1" "$2" "$3" >&2
  exit 2
}

add_model_shortcut() {
  local shortcut="$1"
  local model="$2"

  if [ -n "$model_shortcut" ]; then
    shortcut_conflict model "$model_shortcut" "$shortcut"
  fi
  model_shortcut="$shortcut"
  codex_args+=(--model "$model")
}

add_reasoning_shortcut() {
  local shortcut="$1"
  local effort="$2"

  if [ -n "$reasoning_shortcut" ]; then
    shortcut_conflict reasoning "$reasoning_shortcut" "$shortcut"
  fi
  reasoning_shortcut="$shortcut"
  codex_args+=(
    -c
    "model_reasoning_effort=\"$effort\""
  )
}

add_permission_shortcut() {
  local shortcut="$1"

  if [ -n "$permission_shortcut" ]; then
    shortcut_conflict permission "$permission_shortcut" "$shortcut"
  fi
  permission_shortcut="$shortcut"

  case "$shortcut" in
    --safe)
      codex_args+=(--sandbox read-only --ask-for-approval untrusted)
      ;;
    --auto)
      codex_args+=(--sandbox workspace-write --ask-for-approval on-request)
      ;;
    --full-auto)
      codex_args+=(--sandbox workspace-write --ask-for-approval never)
      ;;
    --madmax)
      codex_args+=(--yolo)
      ;;
  esac
}

codex_args=(
  --no-alt-screen
  -c "$CXT_TRANSCRIPT_CONFIG"
)
passthrough=0
model_shortcut=
reasoning_shortcut=
permission_shortcut=
session_action=
session_shortcut=
session_target=
codex_input_seen=0

while [ "$#" -gt 0 ]; do
  arg="$1"
  shift

  if [ "$passthrough" -eq 1 ]; then
    codex_args+=("$arg")
    codex_input_seen=1
    continue
  fi

  case "$arg" in
    --cxt-help)
      print_cxt_help
      exit 0
      ;;
    --)
      passthrough=1
      codex_args+=("$arg")
      codex_input_seen=1
      ;;
    --attach|--at)
      add_session_action attach "$arg"
      if [ "$#" -gt 0 ]; then
        case "$1" in
          -*) ;;
          *)
            set_session_target "$1"
            shift
            ;;
        esac
      fi
      ;;
    --attach=*|--at=*)
      add_session_action attach "${arg%%=*}"
      set_session_target "${arg#*=}"
      ;;
    --kill-session|--ks)
      add_session_action kill-one "$arg"
      if [ "$#" -gt 0 ]; then
        case "$1" in
          -*) ;;
          *)
            set_session_target "$1"
            shift
            ;;
        esac
      fi
      ;;
    --kill-session=*|--ks=*)
      add_session_action kill-one "${arg%%=*}"
      set_session_target "${arg#*=}"
      ;;
    --kill-all|--ka)
      add_session_action kill-all "$arg"
      ;;
    --sol)
      codex_input_seen=1
      add_model_shortcut "$arg" gpt-5.6-sol
      ;;
    --terra)
      codex_input_seen=1
      add_model_shortcut "$arg" gpt-5.6-terra
      ;;
    --luna)
      codex_input_seen=1
      add_model_shortcut "$arg" gpt-5.6-luna
      ;;
    --gpt55)
      codex_input_seen=1
      add_model_shortcut "$arg" gpt-5.5
      ;;
    --gpt54)
      codex_input_seen=1
      add_model_shortcut "$arg" gpt-5.4
      ;;
    --mini)
      codex_input_seen=1
      add_model_shortcut "$arg" gpt-5.4-mini
      ;;
    --spark)
      codex_input_seen=1
      add_model_shortcut "$arg" gpt-5.3-codex-spark
      ;;
    --low|--medium|--high|--xhigh|--max|--ultra)
      codex_input_seen=1
      add_reasoning_shortcut "$arg" "${arg#--}"
      ;;
    --safe|--auto|--full-auto|--madmax)
      codex_input_seen=1
      add_permission_shortcut "$arg"
      ;;
    *)
      codex_input_seen=1
      codex_args+=("$arg")
      ;;
  esac
done

if [ -n "$session_action" ]; then
  if [ "$codex_input_seen" -eq 1 ]; then
    printf 'cxt: session management options cannot be combined with Codex arguments\n' >&2
    exit 2
  fi
  run_session_action
fi

if ! command -v codex >/dev/null 2>&1; then
  printf 'cxt: codex command not found\n' >&2
  exit 127
fi

if ! command -v tmux >/dev/null 2>&1; then
  printf 'cxt: tmux not found; launching Codex directly\n' >&2
  exec codex "${codex_args[@]}"
fi

session_directory="${PWD##*/}"
if [ -z "$session_directory" ]; then
  session_directory="/"
fi

session="${CXT_SESSION_PREFIX}${session_directory}-$(date +%H%M%S)"
session="${session//[^A-Za-z0-9_-]/-}"

if ! tmux new-session \
  -d \
  -s "$session" \
  -c "$PWD" \
  codex "${codex_args[@]}"
then
  exit 1
fi

if ! tmux set-option -t "$session" mouse on; then
  tmux kill-session -t "$session" >/dev/null 2>&1 || true
  exit 1
fi

if ! tmux set-option -w -t "$session" history-limit "$CXT_TMUX_HISTORY_LIMIT"; then
  tmux kill-session -t "$session" >/dev/null 2>&1 || true
  exit 1
fi

# Do not preserve a dead pane even when the user's global tmux setting does.
if ! tmux set-option -w -t "$session" remain-on-exit off; then
  tmux kill-session -t "$session" >/dev/null 2>&1 || true
  exit 1
fi

if [ -n "${TMUX:-}" ]; then
  exec tmux switch-client -t "$session"
fi

exec tmux attach-session -t "$session"
